generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}


model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role Role @default(USER) //Adicionado ADMIN AQUI, lá no middleware garante que seja admin mesmo

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  revoked   Boolean   @default(false)
  revokedAt DateTime? // Timestamp when the token was revoked (optional)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revoked]) // otimiza a busca combinada.
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
